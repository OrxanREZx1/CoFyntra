# Startary AI System — Environment Variables
#
# Copy this file to .env and fill in values.
#
# ---------------------------------------------------------
# MILESTONE 1: LLM configuration (REQUIRED for AI execution)
# ---------------------------------------------------------
OPENAI_API_KEY=sk-...
# STARTARY_MODEL_NAME=gpt-4o
# FAST_MODEL_NAME=gpt-5.6-luna
# REASONING_MODEL_NAME=gpt-5.6-sol
# FAST_MODEL_FALLBACK=gpt-4o-mini
# REASONING_MODEL_FALLBACK=gpt-4o

# ---------------------------------------------------------
# MILESTONE 1: Development settings
# ---------------------------------------------------------
# STARTARY_LOG_LEVEL=INFO

# Experiment revision architecture A/B flag (Milestone 6.2.6). false = M6.2.5.1 loop.
STARTARY_EXPERIMENT_REVISION_V2=false

# First-turn parallel understanding (Milestone 6.2.7). false = sequential interpret -> extract.
STARTARY_PARALLEL_UNDERSTANDING=false

# ---------------------------------------------------------
# MILESTONE 6.1: LangSmith Observability (OPT-IN, DISABLED by default)
# ---------------------------------------------------------
# Tracing is DISABLED by default. Set to 'true' or run CLI with --trace
LANGSMITH_TRACING=false
# LangSmith API key (required only when LANGSMITH_TRACING=true)
# LANGSMITH_API_KEY=lsv2_pt_...
# Project name in LangSmith UI
LANGSMITH_PROJECT=startary-ai-latency
# Privacy masking (keep true to protect founder IP and context)
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Optional workspace ID / custom endpoint
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------
# MILESTONE 2+: Database
# ---------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/startary

# ---------------------------------------------------------
# MILESTONE 3+: Retrieval / Search
# ---------------------------------------------------------
# RETRIEVAL_API_KEY=...
# RETRIEVAL_BASE_URL=...

