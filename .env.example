# Startary AI System — Environment Variables
#
# Copy this file to .env and fill in values.
#
# ---------------------------------------------------------
# MILESTONE 1: LLM configuration (REQUIRED for AI execution)
# ---------------------------------------------------------
OPENAI_API_KEY=sk-...
# STARTARY_MODEL_NAME=gpt-4o

# ---------------------------------------------------------
# MILESTONE 1: Development settings
# ---------------------------------------------------------
# STARTARY_LOG_LEVEL=INFO

# ---------------------------------------------------------
# MILESTONE 2+: Database
# ---------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/startary

# ---------------------------------------------------------
# MILESTONE 3+: Retrieval / Search
# ---------------------------------------------------------
# RETRIEVAL_API_KEY=...
# RETRIEVAL_BASE_URL=...
